<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Tab bar -->
    <LinearLayout
        android:id="@+id/tab_bar"
        android:layout_width="fill_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="@color/surface">

        <TextView
            android:id="@+id/tab_artists"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:text="Artists"
            android:textColor="@color/text_tertiary"
            android:textSize="14sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1px"
            android:layout_height="fill_parent"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/tab_albums"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:text="Albums"
            android:textColor="@color/text_tertiary"
            android:textSize="14sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1px"
            android:layout_height="fill_parent"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/tab_tracks"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:text="Tracks"
            android:textColor="@color/walkman_blue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Search bar -->
    <LinearLayout
        android:id="@+id/search_bar"
        android:layout_width="fill_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:background="@color/surface_elevated"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <EditText
            android:id="@+id/search_edit"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:hint="Search music..."
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:background="@color/surface"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingLeft="6dp"
            android:paddingRight="6dp" />

        <TextView
            android:id="@+id/search_clear"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="×"
            android:gravity="center"
            android:textColor="@color/text_tertiary"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Album filter bar -->
    <LinearLayout
        android:id="@+id/filter_bar"
        android:layout_width="fill_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/sort_label"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="Name"
            android:textSize="13sp"
            android:textColor="@color/walkman_blue"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/sort_direction"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text=" ▲"
            android:textSize="15sp"
            android:textColor="@color/walkman_blue"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingRight="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/view_toggle"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="Grid"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <GridView
        android:id="@+id/album_grid"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="3"
        android:verticalSpacing="2dp"
        android:horizontalSpacing="2dp"
        android:stretchMode="columnWidth"
        android:gravity="center"
        android:cacheColorHint="@color/background"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:visibility="gone" />

    <ListView
        android:id="@android:id/list"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/divider"
        android:dividerHeight="1px"
        android:cacheColorHint="@color/background"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="8dp"
        android:paddingLeft="2dp"
        android:paddingRight="2dp" />

    <TextView
        android:id="@android:id/empty"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No music found"
        android:textColor="@color/text_tertiary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Now Playing bar border -->
    <View
        android:id="@+id/now_playing_border"
        android:layout_width="fill_parent"
        android:layout_height="2px"
        android:background="@color/walkman_blue"
        android:visibility="gone" />

    <!-- Now Playing bar -->
    <LinearLayout
        android:id="@+id/now_playing_container"
        android:layout_width="fill_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="@color/now_playing_bar"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="10dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/now_playing_art"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/musicplayer_default_album"
            android:scaleType="centerCrop"
            android:layout_marginRight="8dp" />

        <TextView
            android:id="@+id/now_playing_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <ImageView
            android:id="@+id/now_playing_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/btn_play_selector"
            android:scaleType="fitCenter"
            android:layout_marginLeft="8dp" />
    </LinearLayout>
</LinearLayout>
