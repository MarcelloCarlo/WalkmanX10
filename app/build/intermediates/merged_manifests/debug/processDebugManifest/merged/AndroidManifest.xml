<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.walkman.x10mini"
    android:versionCode="1"
    android:versionName="5.1.0" >

    <uses-sdk
        android:minSdkVersion="7"
        android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <supports-screens
        android:anyDensity="true"
        android:largeScreens="false"
        android:normalScreens="true"
        android:smallScreens="true" />

    <application
        android:debuggable="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Walkman"
        android:testOnly="true"
        android:theme="@style/WalkmanTheme" >
        <activity
            android:name="com.walkman.x10mini.WalkmanActivity"
            android:configChanges="keyboardHidden|keyboard"
            android:label="Walkman"
            android:launchMode="singleTask" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MUSIC_PLAYER" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="content" />
                <data android:host="media" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.walkman.x10mini.NowPlayingActivity"
            android:configChanges="keyboardHidden|keyboard"
            android:label="Now Playing"
            android:launchMode="singleTop" />
        <activity
            android:name="com.walkman.x10mini.EditInfoActivity"
            android:configChanges="keyboardHidden|keyboard"
            android:label="Edit Track Info"
            android:theme="@style/WalkmanTheme" />
        <activity
            android:name="com.walkman.x10mini.JellyfinActivity"
            android:configChanges="keyboardHidden|keyboard"
            android:label="Jellyfin" />
        <activity
            android:name="com.walkman.x10mini.JellyfinSettingsActivity"
            android:configChanges="keyboardHidden|keyboard"
            android:label="Jellyfin Server" />
        <activity
            android:name="com.walkman.x10mini.JellyfinAudioActivity"
            android:configChanges="keyboardHidden|keyboard"
            android:label="Audio Settings" />

        <service
            android:name="com.walkman.x10mini.MusicService"
            android:enabled="true"
            android:exported="false" />
        <service
            android:name="com.walkman.x10mini.MetadataService"
            android:enabled="true"
            android:exported="false" />

        <receiver android:name="com.walkman.x10mini.MediaButtonReceiver" >
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
        <receiver android:name="com.walkman.x10mini.NowPlayingWidget" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.walkman.x10mini.WIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.walkman.x10mini.WIDGET_PLAY_PAUSE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.walkman.x10mini.WIDGET_NEXT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.walkman.x10mini.WIDGET_PREV" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>

</manifest>